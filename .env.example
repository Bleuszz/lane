# Copy to your host's secret store. Never commit real values.
# Better Auth (required on a real database)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://YOUR_LANE_HOST
VITE_AUTH_ENABLED=true

# Postgres (Neon recommended)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# eBay REST (developer.ebay.com). redirect_uri is the RuName, not an https URL.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=
EBAY_ENV=production
EBAY_MARKETPLACE_ID=EBAY_GB
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_LOCATION_KEY=LANE_UK
EBAY_LOCATION_NAME=Lane dispatch
EBAY_LOCATION_LINE1=
EBAY_LOCATION_CITY=
EBAY_LOCATION_POSTCODE=

# Optional AI copy (£5 pack). Server-only.
# XAI_API_KEY=
