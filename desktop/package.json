{
  "name": "lane-desktop",
  "productName": "Lane",
  "version": "0.3.1",
  "description": "Lane Desktop: local marketplace sessions and browser-assisted inventory.",
  "author": "Lane (UK)",
  "private": true,
  "main": "secure-main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win dir",
    "verify:runtime": "electron verify-runtime.cjs"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "uk.lane.desktop",
    "productName": "Lane",
    "copyright": "Lane (UK)",
    "directories": {
      "output": "dist/installer"
    },
    "files": [
      "secure-main.cjs",
      "secure-preload.cjs",
      "security.cjs",
      "session-reader.cjs",
      "client/**",
      "assets/**",
      "package.json",
      "connection-manager.cjs",
      "session-transport.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Lane-Setup-${version}.${ext}",
      "icon": "assets/lane.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lane",
      "uninstallDisplayName": "Lane",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": false
    },
    "electronDist": "node_modules/electron/dist"
  }
}
