# Template only. Put real values in a secret store; never commit them.
# Local preview uses in-memory PGlite when DATABASE_URL is absent.
# Staging/production must enable auth and use a durable PostgreSQL database.
VITE_AUTH_ENABLED=true
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://YOUR_STAGING_HOST
DATABASE_URL=

# eBay developer application. RuName is an eBay redirect identifier.
# Keep staging in sandbox until a separately approved production test.
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=
# Seller policy/location choices are stored per account, never global seller defaults.

# Optional paid inference: leave empty for a zero-cost local/staging test.
XAI_API_KEY=
XAI_LISTING_MODEL=grok-4.3

# Live checkout remains off until billing verification is complete.
LANE_BILLING_V2_READY=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_V2_STARTER=
STRIPE_PRICE_V2_SELLER=
STRIPE_PRICE_V2_PRO=
# Legacy price IDs may be retained only for existing subscription webhook mapping.
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_SELLER=
# STRIPE_PRICE_PRO=

# Never enable plan overrides in staging/production.
LANE_ALLOW_PREVIEW_PLANS=false
# VINTED_USER_AGENT=

# Optional authenticated host scheduler: dedicated random secret, at least 32 chars.
# Leave unset until staging and scheduler access have been approved.
LANE_WORKER_SECRET=
# Enable only after an authorized sandbox order/stock reconciliation test.
LANE_EBAY_ORDER_POLLING=false
